# Copy to .env (git-ignored) next to pom.xml; the application reads it on start.
# Real environment variables override these values.

# Database: matches db/.env.example, the local PostgreSQL from db/docker-compose.yaml.
PREPDECK_DB_URL=jdbc:postgresql://localhost:5432/prepdeck
PREPDECK_DB_USER=prepdeck
PREPDECK_DB_PASSWORD=prepdeck

# Access tokens. JWT_SECRET: at least 32 bytes; empty = a random key per start (local only).
JWT_SECRET=
JWT_ISSUER=prep-deck
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
