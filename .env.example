# Copy to .env (git-ignored) next to pom.xml; the application reads it on start.
# Real environment variables override these values.

# Database: matches db/.env.example, the local PostgreSQL from db/docker-compose.yaml.
PREPDECK_DB_URL=jdbc:postgresql://localhost:5432/prepdeck
PREPDECK_DB_USER=prepdeck
PREPDECK_DB_PASSWORD=prepdeck

# Access tokens. JWT_SECRET: at least 32 bytes; empty = a random key per start (local only).
JWT_SECRET=
JWT_ISSUER=prep-deck
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Email over SMTP. These values fit Mailpit from docker/docker-compose.yaml: letters show at
# http://localhost:8025 and go nowhere else. A real server: its host, 587, a login and both true.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=Prep Deck <no-reply@prepdeck.local>
MAIL_SUPPORT=support@prepdeck.local

# Card images. IMAGES_STORAGE=LOCAL keeps them in IMAGES_DIR (created on start);
# IMAGES_STORAGE=S3 puts them in the bucket below. Unused keys stay empty but must be present.
IMAGES_STORAGE=LOCAL
IMAGES_DIR=./data/images
# S3-compatible bucket. Cloudflare R2: endpoint and keys from R2 > Manage API tokens
# (Object Read & Write on the bucket), region auto.
S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=prep-deck-images
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
